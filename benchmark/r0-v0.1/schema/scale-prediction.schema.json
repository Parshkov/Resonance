{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Parshkov/Resonance/benchmark/r0-v0.1/schema/scale-prediction.schema.json",
  "title": "Structural retrieval scale replay prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "world", "corpus_size", "seed", "synthetic", "feature_distribution", "build_seconds", "index_bytes", "posting_length", "postings_touched", "query_latency_seconds", "recall_at_5", "recall_at_20", "peak_memory_bytes", "replay_hash", "rerun_hash"],
  "properties": {
    "case_id": {"type": "string"},
    "world": {"enum": ["rich_random", "zipf_chains", "extracted_fixture_distribution"]},
    "corpus_size": {"enum": [1000, 10000, 100000, 1000000]},
    "seed": {"type": "integer"},
    "synthetic": {"type": "boolean"},
    "feature_distribution": {"type": "string", "minLength": 1},
    "build_seconds": {"type": "number", "minimum": 0},
    "index_bytes": {"type": "integer", "minimum": 0},
    "posting_length": {
      "type": "object", "additionalProperties": false,
      "required": ["median", "p95", "maximum"],
      "properties": {"median": {"type": "number", "minimum": 0}, "p95": {"type": "number", "minimum": 0}, "maximum": {"type": "number", "minimum": 0}}
    },
    "postings_touched": {"type": "integer", "minimum": 0},
    "query_latency_seconds": {
      "type": "object", "additionalProperties": false,
      "required": ["p50", "p95"],
      "properties": {"p50": {"type": "number", "minimum": 0}, "p95": {"type": "number", "minimum": 0}}
    },
    "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
    "recall_at_20": {"type": "number", "minimum": 0, "maximum": 1},
    "peak_memory_bytes": {"type": "integer", "minimum": 0},
    "replay_hash": {"type": "string", "minLength": 1},
    "rerun_hash": {"type": "string", "minLength": 1}
  }
}
